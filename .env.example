# কোন provider active থাকবে সেটা এখানে বদলান: groq | openai | claude
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=openai

# --- প্রতিটা provider-এর নিজস্ব key ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Shopify (dev store) ---
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- DB (Railway হলে automatically inject হয়) ---
DATABASE_URL=postgresql://user:password@localhost:5432/ai_shopify
DB_SSL=false

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
DEMO_USER_EMAIL=demo@client.com
DEMO_USER_PASSWORD=demo1234

# server port (Railway নিজে inject করে)
# PORT=3000
